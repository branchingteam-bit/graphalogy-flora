{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about", "destination": "/my-story", "permanent": true },
    { "source": "/about.html", "destination": "/my-story", "permanent": true },
    { "source": "/programs", "destination": "/services#programs", "permanent": true },
    { "source": "/programs.html", "destination": "/services#programs", "permanent": true }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
